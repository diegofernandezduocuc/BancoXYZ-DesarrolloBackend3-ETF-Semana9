# Nombre exclusivo para una instalación independiente; nunca reutilizar el entorno de desarrollo.
COMPOSE_PROJECT_NAME=bancoxyz_etf_s9_entrega
# Copiar como .env y elegir tres secretos diferentes; nunca publicar .env.
OAUTH_CLIENT_ID=bancoxyz-client
OAUTH_CLIENT_SECRET=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO
DB_PASSWORD=CAMBIAR_POR_PASSWORD_LOCAL_SEGURA
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_OTRA_CLAVE_ROOT_SEGURA
